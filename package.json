{
  "name": "matlens",
  "private": true,
  "version": "1.3.0",
  "description": "MATLens - From Market Data to Brand Decisions. A pharmaceutical MAT market-data intelligence prototype.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false --pretty",
    "gen:demo": "node scripts/generate-demo-files.mjs",
    "verify": "node scripts/verify.mjs",
    "convert": "node --max-old-space-size=4096 scripts/convert-basefile.mjs"
  },
  "dependencies": {
    "papaparse": "^5.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/papaparse": "^5.3.14",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "exceljs": "^4.4.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "engines": {
    "node": ">=20.18"
  }
}
